# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES (Supabase & Multi-Tenant Deployment)
# -----------------------------------------------------------------------------

# Supabase Project URL & Anon Key (Found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Used for server-side administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Privacy-friendly Analytics (e.g. Plausible or Vercel Analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=menu.yourdomain.com
