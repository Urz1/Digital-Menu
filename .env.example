# -----------------------------------------------------------------------------
# DIGITAL MENU — PRODUCTION ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=https://menu.yourrestaurant.com

# 2. Supabase Multi-Tenant PostgreSQL & Realtime
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Cookieless Analytics (Plausible / Self-Hosted)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=menu.yourrestaurant.com
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# 4. Reliability & Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# 5. Environment
NODE_ENV=production
